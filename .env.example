# Copy this file to .env and fill in your values

# PostgreSQL connection string — use a cloud DB like Neon (https://neon.tech) for Netlify
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/rememberme?schema=public&sslmode=require"

# Secret key for JWT tokens — use a long random string
JWT_SECRET="your_long_random_secret_here"

# OpenAI API key (for AI memory assistant)
OPENAI_API_KEY="sk-..."

# App URL — your Netlify site URL after deployment
NEXT_PUBLIC_APP_URL="https://your-site.netlify.app"
